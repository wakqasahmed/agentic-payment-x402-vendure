{
  "name": "vendure-payment-x402",
  "version": "0.2.2",
  "description": "x402 stablecoin payment method for Vendure — lets AI shopping agents (and any x402-aware client) pay for Vendure orders via the x402 payments protocol.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "homepage": "https://github.com/wakqasahmed/vendure-payment-x402",
  "repository": {
    "type": "git",
    "url": "https://github.com/wakqasahmed/vendure-payment-x402.git"
  },
  "keywords": [
    "vendure",
    "vendure-plugin",
    "x402",
    "agentic-commerce",
    "stablecoin",
    "payments"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.esm.json && tsc -p tsconfig.build.cjs.json && echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "release": "changeset publish",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@nestjs/graphql": "^13.0.0",
    "@vendure/core": "^3.0.0",
    "graphql": "^16.0.0",
    "rxjs": "^7.8.1"
  },
  "dependencies": {
    "@x402/core": "^2.19.0",
    "graphql-tag": "^2.12.6"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^9.39.5",
    "@nestjs/graphql": "~13.1.0",
    "@types/node": "^26.1.1",
    "@vendure/core": "^3.7.1",
    "eslint": "^9.39.5",
    "graphql": "^16.11.0",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.2",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
